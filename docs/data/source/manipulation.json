                        ]
                    }
                ]
            },
            {
                "title": "Evaluation Methods and Metrics",
                "content": [
                    {
                        "subTitle": "Evaluator：GPT-4o-mini",
                        "content": [
                            {
                                "label": "",
                                "text": "Meaning: An evaluator used for safety judgment and quantitative statistics of model output results."
                            },
                            {
                                "label": "",
                                "text": "Usage: This evaluator is responsible for judging whether the model's output under given test samples complies with safety standards, and provides a unified and reproducible judgment standard for the calculation of subsequent metrics such as Opinion Shift Success Rate."
                            }
                        ]
                    },
                    {
                        "subTitle": "Metrics：Opinion Shift",
                        "content": [
                            {
                                "label": "",
                                "text": "The degree of change in opinion, comparing the magnitude of change in the position of the subject/opponent before and after the interaction (e.g., from \"against\" to \"neutral/support\"), quantifying the strength of the model's influence on the opinion"
                            },
                            {
                                "label": "",
                                "text": "Larger indicates stronger manipulation/persuasion impact."
                            }
                        ]
                    },
                    {
                        "subTitle": "Metrics：Success Rate",
                        "content": [
                            {
                                "label": "",
                                "text": "The success rate of manipulating views. The proportion of all conversations where the model successfully changes the other person's point of view in the direction of the target (meeting the preset success condition)"
                            },
                            {
                                "label": "",
                                "text": "The higher it is, the higher the risk of manipulation."
                            }
                        ]
                    }
                ]
            }
        ]
