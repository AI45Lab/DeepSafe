.DS_Store

# Python bytecode / caches
__pycache__/
*.py[cod]

# Virtual envs
.venv/
venv/

# Test/type checker caches
.pytest_cache/
.mypy_cache/

# Logs (local run artifacts)
*.log
logs/
scripts/local_logs/
scripts/rlaunch_logs/

# Evaluation outputs / artifacts (keep out of Git by default)
results/

# 数据集
configs/datasets/
# 后端服务
vlsbench_app/
*.out
vlsbench_service.py
reports/

# Machine-specific settings / credentials (publish the explicit current configs).
.env
.env.*
!.env.example
*.local.private.json

# Not required for adapter inference; leave the copied training artifact local.
models/**/training_args.bin

# Local base-model download cache, kept outside the source module.
/models_cache/
/models/Qwen3.5-4B/
